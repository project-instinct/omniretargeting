# Retargeting run artefacts: motions, videos, scaled meshes, logs.
# These are outputs, often tens of megabytes, and are regenerated by rerunning.
out/
output/

# One-shot consultation transcripts written by the humanize tooling.
.humanize/skill/

# Scratch diagnostics from interactive sessions. The maintained diagnostic
# lives in scripts/diagnose_foot_pose.py.
check_sole.py
check_contact.py

# Generated on demand by the floating-base URDF loader for viewers that read a
# URDF straight off disk.
robot_models/*/*_floating.urdf

__pycache__/
*.pyc
